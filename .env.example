# ─── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ATLAS-OPS
SECRET_KEY=your-super-secret-admin-key-change-me

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://atlas:atlas_pass@localhost:5432/atlas_ops

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Fraud Detection ─────────────────────────────────────────────────────────
FRAUD_THRESHOLD=0.65

# ─── Circuit Breaker ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# ─── ML Model Paths ──────────────────────────────────────────────────────────
# Leave blank to use stub models (for development/testing)
FRAUD_MODEL_PATH=app/ml_models/fraud_model.pkl
FAILURE_MODEL_PATH=app/ml_models/failure_model.pkl
ROUTING_MODEL_PATH=app/ml_models/routing_model.pkl

# ─── LLM / RAG ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Gateway URLs (mock or real) ─────────────────────────────────────────────
STRIPE_URL=https://api.stripe.com/mock
RAZORPAY_URL=https://api.razorpay.com/mock
PAYPAL_URL=https://api.paypal.com/mock
SQUARE_URL=https://api.squareup.com/mock

# ─── Idempotency ─────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
